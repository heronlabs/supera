{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heronlabs.com/supera.schema.json",
  "title": "supera configuration",
  "description": "Per-repo configuration for supera. Written by /start, read by every skill.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "baseBranch": {
      "description": "Branch worktrees branch off and PRs target.",
      "type": "string",
      "default": "main"
    },
    "remote": {
      "description": "Git remote name.",
      "type": "string",
      "default": "origin"
    },
    "buildCommand": {
      "description": "Shell command to build the project.",
      "type": "string",
      "examples": ["pnpm build", "npm run build", "cargo build"]
    },
    "lintCommand": {
      "description": "Shell command to lint the project.",
      "type": "string",
      "examples": ["pnpm lint", "npm run lint", "cargo clippy"]
    },
    "testCommands": {
      "description": "Test commands keyed by layer. /start detects what exists — only keys the repo actually has are emitted.",
      "type": "object",
      "additionalProperties": {"type": "string"},
      "default": {},
      "examples": [
        {
          "unit": "pnpm test:unit",
          "integration": "pnpm test:integration",
          "e2e": "pnpm test:e2e"
        },
        {"unit": "cargo test"}
      ]
    },
    "mergeMethod": {
      "description": "PR merge method.",
      "type": "string",
      "enum": ["merge", "squash", "rebase"],
      "default": "squash"
    }
  }
}
